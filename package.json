{
  "name": "ha-git-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Lovelace card bundled with the Git Sync Home Assistant integration",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/git-sync-card.js --bundle --minify --format=esm --target=es2021 --outfile=custom_components/git_sync/frontend/git-sync-card.js",
    "watch": "npm run build -- --watch",
    "lint": "biome check src",
    "format": "biome check --write src",
    "jscpd": "jscpd src custom_components"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "esbuild": "^0.28.2",
    "jscpd": "^5.4.2"
  }
}
